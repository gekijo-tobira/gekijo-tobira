---
export interface Props {
  title: string;
  description?: string;
  /** 記事ページで指定する公開日（YYYY-MM-DD）。未指定ならJSON-LDは WebSite になる */
  pubDate?: string;
  /** 記事ページで指定する更新日（YYYY-MM-DD）。未指定なら pubDate を使う */
  updatedDate?: string;
  /** OGP画像のパス。未指定なら共通画像 */
  ogImage?: string;
  /** アフィリエイト広告を含むページで true にする */
  hasAd?: boolean;
}

const {
  title,
  description = 'AKB48劇場公演の行き方・チケットの取り方・楽しみ方を初心者向けに解説するガイドブログ',
  pubDate,
  updatedDate,
  ogImage = '/images/og-default.png',
  hasAd = false,
} = Astro.props;

const SITE_NAME = '劇場への扉';
// ▼ 運営者名（ハンドルネーム）。about ページの author と揃えること
const AUTHOR = 'トビ';

// 正規URL。本番は末尾スラッシュありが正規（例: /articles/xxx/）
const normalizedPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(normalizedPath, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const isArticle = Astro.url.pathname.startsWith('/articles/');
const pageTitle = Astro.url.pathname === '/' ? `${SITE_NAME} | AKB48劇場 はじめての1公演ガイド` : `${title} | ${SITE_NAME}`;

// 構造化データ
const jsonLd = isArticle && pubDate
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: ogImageURL.href,
      datePublished: pubDate,
      dateModified: updatedDate ?? pubDate,
      author: { '@type': 'Person', name: AUTHOR },
      publisher: { '@type': 'Organization', name: SITE_NAME },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE_NAME,
      description,
      url: new URL('/', Astro.site).href,
    };
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --color-primary: #c0396b;
        --color-bg: #fff8fb;
        --color-text: #1a1a1a;
        --color-muted: #666;
        --max-width: 780px;
        --font-sans: 'Helvetica Neue', 'Hiragino Sans', 'Meiryo', sans-serif;
      }
      body {
        font-family: var(--font-sans);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.75;
      }
      a { color: var(--color-primary); text-decoration: none; }
      a:hover { text-decoration: underline; }

      /* Header */
      .site-header {
        background: #fff;
        border-bottom: 2px solid var(--color-primary);
        padding: 0.75rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .site-header a { color: var(--color-text); font-weight: 700; font-size: 1.1rem; }
      .site-header a:hover { text-decoration: none; color: var(--color-primary); }

      /* Main */
      main {
        max-width: var(--max-width);
        margin: 2rem auto;
        padding: 0 1.25rem;
      }

      /* PR表記 */
      .pr-notice {
        font-size: 0.75rem;
        line-height: 1.4;
        color: var(--color-muted);
        text-align: left;
        margin-bottom: 0.75rem;
      }

      /* Footer */
      .site-footer {
        text-align: center;
        padding: 2rem 1rem;
        color: var(--color-muted);
        font-size: 0.85rem;
        border-top: 1px solid #eee;
        margin-top: 4rem;
      }
      .footer-nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem 1.25rem;
        margin-bottom: 1rem;
      }
      .footer-nav a { color: var(--color-muted); }
      .footer-note { margin-top: 0.5rem; font-size: 0.8rem; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a href="/">🎭 劇場への扉</a>
    </header>

    <main>
      {/* PR表記は全ページに必須（ASP・広告主の規約）。条件を付けて出し分けないこと。CLAUDE.md ⑧参照 */}
      <p class="pr-notice">
        {isArticle ? '本記事にはプロモーションを含みます' : '当サイトはアフィリエイト広告を利用しています'}
      </p>
      <slot />
    </main>

    <footer class="site-footer">
      <nav class="footer-nav" aria-label="フッターメニュー">
        <a href="/about/">運営者情報</a>
        <a href="/privacy/">プライバシーポリシー</a>
        <a href="/contact/">お問い合わせ</a>
      </nav>
      <p>© {new Date().getFullYear()} 劇場への扉 — AKB48劇場公演ガイド</p>
      <p class="footer-note">当サイトはアフィリエイト広告を利用しています</p>
    </footer>
    <!-- Cloudflare Web Analytics --><script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "4a471956a2824fa981d9f6affd79c497"}'></script><!-- End Cloudflare Web Analytics -->
</body>
</html>
